# Copy to .env. No secrets are needed for the local MVP.
MODE=live
LLM_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text
SEARCH_REGION=us-en

# Read by the Ollama server, not the app: set it before starting Ollama.
# Ollama's default context is small and long evidence prompts get cut off silently.
OLLAMA_CONTEXT_LENGTH=8192
